{
  "name": "aircanvas",
  "version": "1.0.0",
  "description": "AirCanvas 空中画板：摄像头捏合手势在空中画画",
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "predev": "npm run copy-wasm",
    "dev": "vite",
    "prebuild": "npm run copy-wasm",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy:gh": "bash scripts/deploy-gh-pages.sh",
    "e2e": "python3 e2e/e2e.py http://127.0.0.1:4173/ local",
    "stress": "python3 e2e/stress.py http://127.0.0.1:4173/ 180"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "private": true
}
